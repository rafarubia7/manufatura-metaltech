MYSQL_USER=metaltech
MYSQL_PASSWORD=root123456
MYSQL_ROOT_PASSWORD=root123456
# Chave do dispositivo para POST /api/v1/leituras. Vazia = sem autenticação (apenas desenvolvimento).
API_KEY=

# Docker: serviços opcionais do compose.yaml. No servidor do laboratório (mesma rede do mestre
# IO-Link), "esteira" faz o gateway subir junto com o "docker compose up -d".
# COMPOSE_PROFILES=esteira
# IP do mestre IO-Link para o gateway em contêiner. Vazio = usa o mestre_url do automacao/config.json.
GATEWAY_MESTRE_URL=
